{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebay-production-oauth-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
