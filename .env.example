# Copy this file to .env, make it private with chmod 600, and replace every
# "replace-with-..." value locally. Never commit .env.
#
# eBay Sandbox application keyset. Never use an eBay login password here.
EBAY_ENVIRONMENT=sandbox
APP_FEATURE_STAGE=drafts
EBAY_CLIENT_ID=replace-with-sandbox-client-id
EBAY_CLIENT_SECRET=replace-with-rotated-sandbox-cert-id
EBAY_RUNAME=replace-with-oauth-enabled-sandbox-runame

# Local application protection and encrypted token/action storage.
# Generate the password and key with the commands in README.md.
# APP_ADMIN_PASSWORD may be the plaintext password itself, or (recommended)
# a pbkdf2_sha256$... hash produced by ebay_app/password_hash.py -- see README.md.
APP_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-20-characters
APP_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_DATABASE_PATH=./instance/ebay-sandbox.sqlite

# Sandbox marketplace defaults. Change these only when deliberately targeting a
# different Sandbox marketplace.
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_CONTENT_LANGUAGE=en-GB
EBAY_CURRENCY=GBP

# Optional Phase 5 Sandbox seller settings. Leave all policy IDs blank or set
# all three together. These are identifiers, not passwords.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# The OAuth callback is permanently http://127.0.0.1:5000/oauth/callback.
# HOST and PORT are validated and must not be changed.
EBAY_REQUEST_TIMEOUT_SECONDS=15
EBAY_ORDER_LOOKBACK_DAYS=30

# Section 6 production price-safety controls (see ebay_app/prices.py). All
# three have safe built-in defaults -- shown below -- and can be changed at
# any time without a code change: edit the value and restart the application.
APP_MAX_PRICE_CHANGE_PERCENT=10
APP_MAX_ACTIONS_PER_RUN=10
APP_REQUIRE_PRICE_FLOOR=true

# The write-phase kill switch (see ebay_app/prices.py). Defaults to false in
# Sandbox (every existing Sandbox phase already makes real Sandbox writes) --
# shown explicitly here for documentation. A production config defaults this
# to true instead; see .env.production.example.
APP_DRY_RUN=false

HOST=127.0.0.1
PORT=5000

# Autonomy engine (docs/autonomy_engine.md). off | shadow | auto-dry | auto.
# There is deliberately no default margin: leave it blank and set
# margin_percent per SKU with import_costs.py after reviewing the shadow report.
APP_ENGINE_MODE=off
APP_ENGINE_DEFAULT_MARGIN_PERCENT=
APP_ENGINE_REPRICE_HOURS=24
APP_ENGINE_RELIST_MINUTES=60
APP_ENGINE_ORDERS_MINUTES=30

# Email alerts from the engine (optional; all blank = off). For iCloud use
# smtp.mail.me.com / 587 and an app-specific password created in your Apple
# Account settings. Enter these yourself -- never paste them into a chat.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_APP_PASSWORD=
APP_ALERT_EMAIL=
APP_ENGINE_DIGEST_HOURS=6
