# Copy this file to .env.production, make it private with chmod 600, and
# replace every "replace-with-..." value locally. Never commit
# .env.production.
#
# This file is only ever loaded by run_production.py, never by run.py, and
# only takes effect once APP_ALLOW_PRODUCTION_ENVIRONMENT below is set to the
# exact literal value shown. Read README.md's "Production (Phase 9
# preparation)" section before creating this file for real. Production write
# capability is gradual and each stage needs its own separate, explicit
# opt-in, documented in ebay_app/config.py's PRODUCTION_WRITE_OPT_INS dict:
# "prices" needs APP_ALLOW_PRODUCTION_PRICE_WRITES, "quantities" needs
# APP_ALLOW_PRODUCTION_QUANTITY_WRITES, "images" needs
# APP_ALLOW_PRODUCTION_IMAGE_WRITES -- each in addition to the opt-in below
# and that stage's own APP_FEATURE_STAGE value. Even once one is reachable,
# APP_DRY_RUN defaults to true below, so no real eBay write happens until
# that is also explicitly set to false.
#
# A separate, one-off "migration" stage also exists, for bringing an
# existing classic (non-Inventory-API) listing under this app's management --
# see claude/listing_migration_plan.md. It needs
# APP_ALLOW_PRODUCTION_LISTING_MIGRATION set and APP_FEATURE_STAGE=migration,
# only while actually running migrate_listing.py -- set APP_FEATURE_STAGE
# back afterward, since it is not meant to stay selected. It has no
# APP_DRY_RUN rehearsal mode at all.
EBAY_ENVIRONMENT=production
APP_ALLOW_PRODUCTION_ENVIRONMENT=yes-i-understand-the-risk
APP_FEATURE_STAGE=connection

# Real eBay Production application keyset. Never use an eBay login password
# here, and never reuse the Sandbox keyset above.
EBAY_CLIENT_ID=replace-with-production-client-id
EBAY_CLIENT_SECRET=replace-with-rotated-production-cert-id
EBAY_RUNAME=replace-with-oauth-enabled-production-runame

# Local application protection and encrypted token/action storage. These
# MUST differ from the Sandbox .env values -- startup refuses to run if this
# database path or encryption key match the Sandbox configuration.
APP_ADMIN_PASSWORD=replace-with-a-different-random-password-of-at-least-20-characters
APP_DATA_ENCRYPTION_KEY=replace-with-a-different-base64-encoded-32-byte-key
APP_DATABASE_PATH=./instance/ebay-production.sqlite

# Real seller marketplace. Change only when deliberately targeting a
# different Production marketplace than EBAY_GB.
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_CONTENT_LANGUAGE=en-GB
EBAY_CURRENCY=GBP

# Real seller business-policy IDs and merchant location key. Sandbox IDs are
# not valid in Production -- these must be created/recreated against the
# real account first (see README.md and docs/RUNBOOK.md). Leave all policy
# IDs blank or set all three together.
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# The OAuth callback is permanently http://127.0.0.1:5000/oauth/callback.
# HOST and PORT are validated and must not be changed.
EBAY_REQUEST_TIMEOUT_SECONDS=15
EBAY_ORDER_LOOKBACK_DAYS=30

# Section 6 production price-safety controls (see ebay_app/prices.py). All
# three have safe built-in defaults -- shown below -- and can be changed at
# any time without a code change: edit the value and restart the application.
APP_MAX_PRICE_CHANGE_PERCENT=10
APP_MAX_ACTIONS_PER_RUN=10
APP_REQUIRE_PRICE_FLOOR=true

# The write-phase kill switch (see ebay_app/prices.py). A production config
# defaults this to true even if left unset -- shown explicitly here so it is
# never mistaken for an oversight. Set to false only once you are genuinely
# ready for a real write to reach the live account.
APP_DRY_RUN=true

HOST=127.0.0.1
PORT=5000
