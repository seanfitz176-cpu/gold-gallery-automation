# Private runtime configuration and credentials
.env
.env.*
!.env.example
!.env.production.example
.dev.vars
.dev.vars.*
.envrc
.npmrc
.pypirc
.netrc

# Local OAuth grants, action journals, and databases
instance/
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# Python environments, caches, coverage, and build output
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Node and Cloudflare local state
node_modules/
.wrangler/
oauth_relay_worker/.wrangler/
oauth_relay_worker_production/.wrangler/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Logs, editor files, and operating-system metadata
*.log
.DS_Store
.idea/
.vscode/
*.swp
*~

# Private key and certificate files must never be committed
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa

# Locally-generated secrets -- never commit
instance/.production_admin_password.txt
.cf_api_token
account_deletion_worker/.cf_api_token
oauth_relay_worker/.cf_api_token

# Autonomous Claude session controls -- owner-local state, never committed
.claude/STOP
.claude/checkpoints/*.approved
.claude/settings.local.json
